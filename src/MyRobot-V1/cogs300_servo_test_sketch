
/*
 * COGS 300 - Lab 08
 * Standalone Servo Sweep Test
 *
 * Purpose:
 * - Test servo movement without Servo.h.
 * - Sweep in 30-degree increments.
 * - Preserve PWM functionality on pins 9 and 10.
 *
 * Sweep:
 * 30 -> 60 -> 90 -> 120 -> 150
 * 150 -> 120 -> 90 -> 60 -> 30
 *
 * Hardware:
 * - Arduino Uno
 * - Standard positional servo
 * - Servo signal connected to A5
 *
 * This is a standalone test.
 * Do not add it to the tournament sketch yet.
 */

// ==========================================
// SERVO CONFIGURATION
// ==========================================

const int servoPin = A5;

// Servo pulse widths (microseconds).
//
// These are approximate values for a
// standard 180-degree positional servo.
const int servoMinPulse = 1000;
const int servoMaxPulse = 2000;

// Sweep settings.
const int servoMinAngle = 30;
const int servoMaxAngle = 150;
const int servoStep = 30;

// Servo refresh period (microseconds).
const unsigned long servoPeriod = 20000UL;

// Time spent at each position (milliseconds).
const unsigned long servoHoldTime = 700;

// ==========================================
// SWEEP VARIABLES
// ==========================================

// Start at the minimum sweep angle.
int currentServoAngle = servoMinAngle;

// +1 means increasing angle.
// -1 means decreasing angle.
int servoDirection = 1;

// ==========================================
// SEND ONE SERVO PULSE
// ==========================================

void sendServoPulse(int angle) {

  // Keep requested angle within 0-180.
  angle = constrain(angle, 0, 180);

  // Convert angle to pulse width.
  int pulseWidth = map(
    angle,
    0, 180,
    servoMinPulse,
    servoMaxPulse
  );

  // Send the HIGH portion of the pulse.
  digitalWrite(servoPin, HIGH);
  delayMicroseconds(pulseWidth);

  // Finish the pulse.
  digitalWrite(servoPin, LOW);

  // Wait until the next refresh period.
  delayMicroseconds(servoPeriod - pulseWidth);
}

// ==========================================
// HOLD SERVO AT AN ANGLE
// ==========================================

void holdServoPosition(int angle,
                       unsigned long durationMs) {

  unsigned long startTime = millis();

  // Continuously send servo pulses to
  // maintain the requested position.
  while (millis() - startTime < durationMs) {
    sendServoPulse(angle);
  }
}

// ==========================================
// ADVANCE TO NEXT SWEEP POSITION
// ==========================================

void advanceServoPosition() {

  // Move one increment in the current direction.
  currentServoAngle += servoStep * servoDirection;

  // Reverse direction at the maximum angle.
  if (currentServoAngle >= servoMaxAngle) {

    currentServoAngle = servoMaxAngle;
    servoDirection = -1;
  }

  // Reverse direction at the minimum angle.
  else if (currentServoAngle <= servoMinAngle) {

    currentServoAngle = servoMinAngle;
    servoDirection = 1;
  }
}

// ==========================================
// ARDUINO SETUP
// ==========================================

void setup() {

  Serial.begin(9600);

  pinMode(servoPin, OUTPUT);
  digitalWrite(servoPin, LOW);

  Serial.println("==========================");
  Serial.println("COGS 300 - SERVO SWEEP TEST");
  Serial.println("No Servo.h library");
  Serial.println("==========================");

  Serial.println("Sweep range: 30 to 150 degrees");
  Serial.println("Step size: 30 degrees");

  // Begin by holding the servo at 30 degrees.
  holdServoPosition(currentServoAngle, 1000);
}

// ==========================================
// MAIN LOOP
// ==========================================

void loop() {

  Serial.print("Servo angle: ");
  Serial.println(currentServoAngle);

  // Hold the current position long enough
  // for the servo to physically move there.
  holdServoPosition(currentServoAngle, servoHoldTime);

  // Advance to the next position.
  advanceServoPosition();
}
