
/*
 * COGS 300 - Lab 07
 * Three-Sensor Autonomous Line Following
 *
 * Features:
 * - Three IR sensors (left, center, right).
 * - LOW indicates white tape.
 * - Straight movement when centered.
 * - Gradual left/right steering.
 * - Stronger corrections for sharp turns.
 * - Immediate recovery when all sensors lose tape.
 *
 * Motor configuration preserved from Lab 5.
 */

// ==========================================
// MOTOR PIN CONFIGURATION
// ==========================================

// Motor A (Left Wheel)
const int enA = 5;
const int in1 = 6;
const int in2 = 7;

// Motor B (Right Wheel)
const int enB = 9;
const int in3 = 10;
const int in4 = 11;

// ==========================================
// IR SENSOR CONFIGURATION
// ==========================================

const int leftIRPin = A0;
const int centerIRPin = A1;
const int rightIRPin = A2;

// Confirmed calibration:
// HIGH = Dark floor
// LOW  = White tape
const int WHITE_DETECTED = LOW;

bool leftOnLine = false;
bool centerOnLine = false;
bool rightOnLine = false;

// ==========================================
// MOTOR SPEED CONFIGURATION
// ==========================================

// Normal forward speed.
// Preserved from our working Lab 7 code.
const int baseSpeed = 100;

// Strong steering correction.
//
// Previously:
// turnSpeed = 95
// slowSpeed = 80
//
// Increasing the difference between wheel
// speeds allows the robot to turn more sharply.
const int turnSpeed = 105;
const int slowSpeed = 40;

// Gentle steering correction.
//
// Previously:
// slightFastSpeed = 85
// slightSlowSpeed = 70
//
// These values provide a moderate correction
// when the center and one side sensor detect
// the white tape simultaneously.
const int slightFastSpeed = 90;
const int slightSlowSpeed = 60;

// Rotation speed during line recovery.
// Preserved from our previous implementation.
const int searchSpeed = 65;

// ==========================================
// LINE RECOVERY CONFIGURATION
// ==========================================

// Track the last known direction of the tape.
//
// -1 = Tape last detected toward the left
//  0 = No known direction
//  1 = Tape last detected toward the right
int lastDirection = 0;

// Track whether the robot has lost the tape.
bool lineLost = false;

// ==========================================
// SETUP
// ==========================================

void setup() {

  // Configure motor pins.
  pinMode(enA, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);

  pinMode(enB, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);

  // Configure IR sensor pins.
  pinMode(leftIRPin, INPUT);
  pinMode(centerIRPin, INPUT);
  pinMode(rightIRPin, INPUT);

  // Initialize Serial Monitor.
  Serial.begin(9600);

  // Ensure the robot starts stationary.
  setMotors(0, 0);

  Serial.println("Lab 7 line-following ready!");
  Serial.println("LOW = White tape.");
}

// ==========================================
// MOTOR CONTROL
// ==========================================

/*
 * Controls the speed and direction of
 * the robot's two motors.
 *
 * Positive speed = Forward
 * Negative speed = Backward
 * Zero = Stop
 *
 * Motor directions preserved from Lab 5.
 */

void setMotors(int leftSpeed, int rightSpeed) {

  // Prevent PWM speeds from exceeding
  // the supported range.
  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);

  // LEFT MOTOR
  if (leftSpeed > 0) {

    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  }
  else if (leftSpeed < 0) {

    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }
  else {

    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }

  // RIGHT MOTOR
  if (rightSpeed > 0) {

    digitalWrite(in3, LOW);
    digitalWrite(in4, HIGH);
  }
  else if (rightSpeed < 0) {

    digitalWrite(in3, HIGH);
    digitalWrite(in4, LOW);
  }
  else {

    digitalWrite(in3, LOW);
    digitalWrite(in4, LOW);
  }

  // Apply PWM speeds to both motors.
  analogWrite(enA, abs(leftSpeed));
  analogWrite(enB, abs(rightSpeed));
}

// ==========================================
// IR SENSOR READINGS
// ==========================================

/*
 * Reads the three IR sensors.
 *
 * Since LOW indicates white tape:
 *
 * true  = Sensor detects white tape
 * false = Sensor detects dark floor
 */

void readIRSensors() {

  leftOnLine =
    digitalRead(leftIRPin) == WHITE_DETECTED;

  centerOnLine =
    digitalRead(centerIRPin) == WHITE_DETECTED;

  rightOnLine =
    digitalRead(rightIRPin) == WHITE_DETECTED;
}

// ==========================================
// LINE RECOVERY
// ==========================================

/*
 * Called when all three IR sensors
 * lose the white tape.
 *
 * Previously, the robot continued moving
 * forward for 100 milliseconds before
 * attempting recovery.
 *
 * This could cause the robot to overshoot
 * sharp corners.
 *
 * NEW BEHAVIOUR:
 * Immediately rotate toward the last
 * known direction of the tape.
 */

void recoverLine() {

  // Record that the tape has been lost.
  if (!lineLost) {
    lineLost = true;
    Serial.println("Line lost! Searching...");
  }

  // CASE 1: Tape was last detected
  // toward the left.
  if (lastDirection == -1) {

    // Rotate in place toward the left.
    setMotors(-searchSpeed, searchSpeed);
  }

  // CASE 2: Tape was last detected
  // toward the right.
  else if (lastDirection == 1) {

    // Rotate in place toward the right.
    setMotors(searchSpeed, -searchSpeed);
  }

  // CASE 3: No previous direction
  // has been established.
  else {

    // Stop rather than searching blindly.
    setMotors(0, 0);
  }
}

// ==========================================
// LINE-FOLLOWING CONTROLLER
// ==========================================

/*
 * Uses the three IR sensors to determine
 * how the robot should move.
 *
 * Sensor patterns:
 *
 * L C R
 * -----
 * 0 1 0 = Forward
 * 1 0 0 = Strong left
 * 0 0 1 = Strong right
 * 1 1 0 = Slight left
 * 0 1 1 = Slight right
 * 1 1 1 = Forward
 * 1 0 1 = Stop (ambiguous)
 * 0 0 0 = Recover lost line
 *
 * 1 indicates white tape detected.
 */

void updateLineFollowing() {

  // Read the latest IR sensor values.
  readIRSensors();

  // ======================================
  // CASE 1: NO WHITE TAPE DETECTED
  // ======================================

  if (!leftOnLine &&
      !centerOnLine &&
      !rightOnLine) {

    // Immediately attempt recovery.
    recoverLine();
    return;
  }

  // At least one sensor detects tape.
  // Reset the line-loss state.
  lineLost = false;

  // ======================================
  // CASE 2: CENTER SENSOR ONLY
  // ======================================

  if (!leftOnLine &&
      centerOnLine &&
      !rightOnLine) {

    // Robot is centered over the tape.
    setMotors(baseSpeed, baseSpeed);

    // Preserve the previous direction
    // for potential future recovery.
  }

  // ======================================
  // CASE 3: LEFT SENSOR ONLY
  // ======================================

  else if (leftOnLine &&
           !centerOnLine &&
           !rightOnLine) {

    // Strong left correction.
    //
    // Left wheel moves slower than
    // right wheel, turning robot left.
    setMotors(slowSpeed, turnSpeed);

    // Remember tape was toward the left.
    lastDirection = -1;
  }

  // ======================================
  // CASE 4: RIGHT SENSOR ONLY
  // ======================================

  else if (!leftOnLine &&
           !centerOnLine &&
           rightOnLine) {

    // Strong right correction.
    setMotors(turnSpeed, slowSpeed);

    // Remember tape was toward the right.
    lastDirection = 1;
  }

  // ======================================
  // CASE 5: LEFT + CENTER SENSORS
  // ======================================

  else if (leftOnLine &&
           centerOnLine &&
           !rightOnLine) {

    // Gentle left correction.
    setMotors(slightSlowSpeed, slightFastSpeed);

    lastDirection = -1;
  }

  // ======================================
  // CASE 6: CENTER + RIGHT SENSORS
  // ======================================

  else if (!leftOnLine &&
           centerOnLine &&
           rightOnLine) {

    // Gentle right correction.
    setMotors(slightFastSpeed, slightSlowSpeed);

    lastDirection = 1;
  }

  // ======================================
  // CASE 7: ALL THREE SENSORS
  // ======================================

  else if (leftOnLine &&
           centerOnLine &&
           rightOnLine) {

    // All sensors detect white tape.
    //
    // Continue forward for now.
    setMotors(baseSpeed, baseSpeed);
  }

  // ======================================
  // CASE 8: LEFT + RIGHT ONLY
  // ======================================

  else {

    // Ambiguous detection pattern.
    //
    // Stop to avoid unpredictable
    // steering behaviour.
    setMotors(0, 0);
  }
}

// ==========================================
// SERIAL MONITOR OUTPUT
// ==========================================

void printSensorReadings() {

  Serial.print("IR [L C R]: ");

  Serial.print(leftOnLine);
  Serial.print(" ");

  Serial.print(centerOnLine);
  Serial.print(" ");

  Serial.print(rightOnLine);

  Serial.print(" | Last direction: ");
  Serial.print(lastDirection);

  Serial.print(" | Line lost: ");
  Serial.println(lineLost);
}

// ==========================================
// MAIN LOOP
// ==========================================

void loop() {

  // Continuously update line-following.
  updateLineFollowing();

  // Print sensor readings every 200 ms
  // without interrupting motor control.
  static unsigned long lastPrintTime = 0;

  if (millis() - lastPrintTime >= 200) {

    printSensorReadings();
    lastPrintTime = millis();
  }

  // Short delay to stabilize polling.
  delay(10);
}
