
/*
 * COGS 300 - Lab 05: Autonomous Wall Following
 *
 * Uses two HC-SR04 ultrasonic sensors:
 * - Front sensor detects approaching obstacles.
 * - Left sensor maintains distance from a wall.
 *
 * A proportional controller adjusts the left
 * and right wheel speeds to follow a left wall.
 *
 * No Processing IDE is required.
 */


// ==========================================
// MOTOR PIN CONFIGURATION
// ==========================================

// Motor A (Left Wheel)
const int enA = 5;
const int in1 = 6;
const int in2 = 7;

// Motor B (Right Wheel)
const int enB = 9;
const int in3 = 10;
const int in4 = 11;


// ==========================================
// ULTRASONIC SENSOR CONFIGURATION
// ==========================================

// Front-facing ultrasonic sensor.
const int frontTrigPin = 2;
const int frontEchoPin = 3;

// Left-facing ultrasonic sensor.
const int leftTrigPin = 13;
const int leftEchoPin = 12;

// Most recent distance measurements.
// -1 indicates no valid echo.
float frontDistance = -1;
float leftDistance = -1;

// Timing for sensor measurements.
unsigned long lastSensorTime = 0;
const unsigned long SENSOR_INTERVAL = 100;


// ==========================================
// WALL-FOLLOWING CONFIGURATION
// ==========================================

// Desired distance from the left wall (cm).
const float targetWallDistance = 15.0;

// Normal forward motor speed (PWM).
const int baseSpeed = 120;

// Proportional gain for steering correction.
const float Kp = 3.0;

// Ignore small distance errors (+/- 2 cm).
const float distanceTolerance = 2.0;

// Maximum steering correction.
const int maxCorrection = 80;

// Stop if an obstacle is closer than 20 cm.
const float frontStopDistance = 20.0;


// ==========================================
// SETUP
// ==========================================

void setup() {

  // Configure motor pins.
  pinMode(enA, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);

  pinMode(enB, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);

  // Configure ultrasonic sensors.
  pinMode(frontTrigPin, OUTPUT);
  pinMode(frontEchoPin, INPUT);

  pinMode(leftTrigPin, OUTPUT);
  pinMode(leftEchoPin, INPUT);

  // Start with both trigger pins LOW.
  digitalWrite(frontTrigPin, LOW);
  digitalWrite(leftTrigPin, LOW);

  // Initialize Serial Monitor.
  Serial.begin(9600);

  // Ensure the robot starts stationary.
  setMotors(0, 0);

  Serial.println("Wall-following robot ready!");
}


// ==========================================
// MOTOR CONTROL
// ==========================================

/*
 * Positive = forward
 * Negative = backward
 * Zero = stop
 *
 * Motor directions match our existing wiring.
 */

void setMotors(int leftSpeed, int rightSpeed) {

  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);

  // LEFT MOTOR
  if (leftSpeed > 0) {
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  }
  else if (leftSpeed < 0) {
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }
  else {
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }

  // RIGHT MOTOR
  if (rightSpeed > 0) {
    digitalWrite(in3, LOW);
    digitalWrite(in4, HIGH);
  }
  else if (rightSpeed < 0) {
    digitalWrite(in3, HIGH);
    digitalWrite(in4, LOW);
  }
  else {
    digitalWrite(in3, LOW);
    digitalWrite(in4, LOW);
  }

  // Apply PWM speeds.
  analogWrite(enA, abs(leftSpeed));
  analogWrite(enB, abs(rightSpeed));
}


// ==========================================
// ULTRASONIC DISTANCE MEASUREMENT
// ==========================================

float measureDistance(int trigPin, int echoPin) {

  // Prepare sensor.
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  // Send ultrasonic pulse.
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // Measure returning echo.
  long duration = pulseIn(echoPin, HIGH, 30000);

  // Return -1 if no echo was detected.
  if (duration == 0) {
    return -1;
  }

  // Convert duration to centimetres.
  return duration * 0.0343 / 2.0;
}


// ==========================================
// WALL-FOLLOWING CONTROLLER
// ==========================================

void updateWallFollowing() {

  // Stop if either sensor has no valid reading.
  if (frontDistance < 0 || leftDistance < 0) {
    setMotors(0, 0);
    return;
  }

  // Stop when an obstacle is directly ahead.
  if (frontDistance <= frontStopDistance) {
    setMotors(0, 0);
    return;
  }

  // Calculate distance error from left wall.
  float error = leftDistance - targetWallDistance;

  // Ignore small corrections near target.
  if (abs(error) <= distanceTolerance) {
    error = 0;
  }

  // Calculate proportional steering correction.
  int correction = constrain(
    (int)(Kp * error),
    -maxCorrection,
    maxCorrection
  );

  // Adjust individual motor speeds.
  // Too far from wall -> steer left.
  // Too close to wall -> steer right.
  int leftSpeed = baseSpeed - correction;
  int rightSpeed = baseSpeed + correction;

  // Apply calculated wheel speeds.
  setMotors(leftSpeed, rightSpeed);
}


// ==========================================
// MAIN LOOP
// ==========================================

void loop() {

  // Update sensor readings approximately
  // every 100 milliseconds.
  if (millis() - lastSensorTime >= SENSOR_INTERVAL) {

    // Measure front-facing distance.
    frontDistance = measureDistance(
      frontTrigPin,
      frontEchoPin
    );

    // Allow echoes to settle before
    // triggering the second sensor.
    delay(30);

    // Measure left-facing distance.
    leftDistance = measureDistance(
      leftTrigPin,
      leftEchoPin
    );

    // Update autonomous steering.
    updateWallFollowing();

    // ------------------------------------------
    // SERIAL MONITOR OUTPUT
    // ------------------------------------------

    Serial.print("Front: ");
    Serial.print(frontDistance);
    Serial.print(" cm | Left: ");
    Serial.print(leftDistance);
    Serial.println(" cm");

    // Record measurement time.
    lastSensorTime = millis();
  }
}
