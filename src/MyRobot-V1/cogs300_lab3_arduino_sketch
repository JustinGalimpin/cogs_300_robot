
/*
 * COGS 300 - Lab 03: Robot Movement
 *
 * Arduino motor controller for Processing IDE.
 *
 * Features:
 * - Independent control of two DC motors
 * - Forward and backward movement
 * - Left and right steering while driving
 * - Rotation in place
 * - PWM speed control
 * - Serial communication with Processing
 * - Automatic stop if communication is lost
 *
 * Processing sends commands in the format:
 * leftSpeed,rightSpeed
 *
 * Positive = forward
 * Negative = backward
 * Zero = stop
 */

// ==========================================
// MOTOR PIN CONFIGURATION
// ==========================================

// Motor A (Left Wheel)
const int enA = 5;   // PWM speed control
const int in1 = 6;   // Direction pin 1
const int in2 = 7;   // Direction pin 2

// Motor B (Right Wheel)
const int enB = 9;   // PWM speed control
const int in3 = 10;  // Direction pin 1
const int in4 = 11;  // Direction pin 2


// ==========================================
// SERIAL COMMUNICATION
// ==========================================

// Buffer for incoming serial commands.
String inputBuffer = "";

// Track the time of the last valid command.
unsigned long lastCommandTime = 0;

// Stop motors if no command is received for 500 ms.
const unsigned long COMMAND_TIMEOUT = 500;


// ==========================================
// SETUP
// ==========================================

void setup() {

  // Configure motor pins as outputs.
  pinMode(enA, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);

  pinMode(enB, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);

  // Initialize serial communication.
  Serial.begin(9600);

  // Ensure the robot starts stationary.
  setMotors(0, 0);

  lastCommandTime = millis();

  Serial.println("Arduino robot controller ready.");
}


// ==========================================
// MOTOR CONTROL
// ==========================================

/*
 * Controls both motors independently.
 *
 * Positive values = forward
 * Negative values = backward
 * Zero = stop
 *
 * Valid range: -255 to 255
 *
 * Motor B direction has been reversed
 * to account for the current wiring.
 */

void setMotors(int leftSpeed, int rightSpeed) {

  // Restrict speeds to valid PWM values.
  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);

  // ------------------------------------------
  // LEFT MOTOR (Motor A)
  // ------------------------------------------

  if (leftSpeed > 0) {
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  }
  else if (leftSpeed < 0) {
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  }
  else {
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }

  // ------------------------------------------
  // RIGHT MOTOR (Motor B)
  // ------------------------------------------

  // Reversed relative to the previous sketch.
  if (rightSpeed > 0) {
    digitalWrite(in3, LOW);
    digitalWrite(in4, HIGH);
  }
  else if (rightSpeed < 0) {
    digitalWrite(in3, HIGH);
    digitalWrite(in4, LOW);
  }
  else {
    digitalWrite(in3, LOW);
    digitalWrite(in4, LOW);
  }

  // Apply PWM speeds.
  analogWrite(enA, abs(leftSpeed));
  analogWrite(enB, abs(rightSpeed));
}


// ==========================================
// SERIAL COMMAND PROCESSING
// ==========================================

/*
 * Processing sends:
 * leftSpeed,rightSpeed\n
 *
 * Example:
 * 180,180
 *
 * The comma separates the motor values.
 * The newline marks the end of a command.
 */

void processCommand(String command) {

  // Locate the comma separating the speeds.
  int commaIndex = command.indexOf(',');

  // Ignore commands without a comma.
  if (commaIndex <= 0) {
    return;
  }

  // Extract the motor speed values.
  String leftText = command.substring(0, commaIndex);
  String rightText = command.substring(commaIndex + 1);

  // Convert strings into integers.
  int leftSpeed = leftText.toInt();
  int rightSpeed = rightText.toInt();

  // Apply the motor speeds.
  setMotors(leftSpeed, rightSpeed);

  // Reset communication timeout.
  lastCommandTime = millis();
}


// ==========================================
// MAIN LOOP
// ==========================================

void loop() {

  // Read incoming serial characters.
  while (Serial.available() > 0) {

    char incoming = Serial.read();

    // A newline indicates a complete command.
    if (incoming == '\n') {

      // Process the received command.
      processCommand(inputBuffer);

      // Clear the buffer.
      inputBuffer = "";
    }
    else if (incoming != '\r') {

      // Store incoming characters.
      if (inputBuffer.length() < 32) {
        inputBuffer += incoming;
      }
      else {
        // Discard excessively long messages.
        inputBuffer = "";
      }
    }
  }

  // ==========================================
  // COMMUNICATION SAFETY TIMEOUT
  // ==========================================

  // Stop motors if Processing disconnects.
  if (millis() - lastCommandTime > COMMAND_TIMEOUT) {
    setMotors(0, 0);
  }
}
